#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define MAC 0
#define WIN 1
#define RIG 2
#define LEF 3
#define TRI 4

/ {
    behaviors {
        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
            };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <RIG LEF>;
            then-layer = <TRI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_layer {
            bindings = <
&none  &kp Q  &kp W  &kp E          &kp R        &kp T             &kp Y           &kp U         &kp I      &kp O    &kp P      &none
&none  &kp A  &kp S  &kp D          &kp F        &kp G             &kp H           &kp J         &kp K      &kp L    &kp SQT    &none
&none  &kp Z  &kp X  &kp C          &kp V        &kp B             &kp N           &kp M         &kp COMMA  &kp DOT  &kp QMARK  &none
                     &ht LSHFT ESC  &lt LEF TAB  &ht LGUI SPACE    &ht RGUI ENTER  &lt RIG BSPC  &kp RCTRL
            >;

            label = "Mac";
        };

        windows_layer {
            bindings = <
&none  &kp Q  &kp W  &kp E          &kp R        &kp T              &kp Y            &kp U         &kp I      &kp O    &kp P      &none
&none  &kp A  &kp S  &kp D          &kp F        &kp G              &kp H            &kp J         &kp K      &kp L    &kp SQT    &none
&none  &kp Z  &kp X  &kp C          &kp V        &kp B              &kp N            &kp M         &kp COMMA  &kp DOT  &kp QMARK  &none
                     &ht LSHFT ESC  &lt LEF TAB  &ht LCTRL SPACE    &ht RCTRL ENTER  &lt RIG BSPC  &kp RCTRL
            >;

            label = "Windows";
        };

        right_layer {
            bindings = <
&none  &kp ESC       &kp N7  &kp N8         &kp N9  &none        &none     &none     &kp UP    &none      &none    &none
&none  &kp DEL       &kp N4  &kp N5         &kp N6  &none        &kp HOME  &kp LEFT  &kp DOWN  &kp RIGHT  &kp END  &none
&none  &ht LSHFT N0  &kp N1  &kp N2         &kp N3  &none        &none     &none     &none     &none      &none    &none
                             &ht LSHFT ESC  &trans  &kp LALT    &trans    &trans    &trans
            >;

            label = "NumNav";
        };

        left_layer {
            bindings = <
&none  &kp EXCL   &kp AT     &kp HASH   &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &none
&none  &kp GRAVE  &kp MINUS  &kp PLUS   &none     &none        &kp COLON  &kp LT    &kp GT     &kp LBKT  &kp RBKT  &none
&none  &kp TILDE  &kp UNDER  &kp EQUAL  &none     &none        &kp SEMI   &kp FSLH  &kp BSLH   &kp LBRC  &kp RBRC  &none
                             &trans     &trans    &trans       &trans     &trans    &trans
            >;

            label = "Symbols";
        };

        tri_layer {
            bindings = <
&none  &kp F1  &kp F2   &kp F3   &kp F4   &bt BT_SEL 0    &bt BT_SEL 2  &out OUT_TOG   &tog WIN    &none         &none         &none
&none  &kp F5  &kp F6   &kp F7   &kp F8   &bt BT_SEL 1    &bt BT_SEL 3  &kp C_BRI_UP   &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &none
&none  &kp F9  &kp F10  &kp F11  &kp F12  &bt BT_CLR      &bt BT_SEL 4  &kp C_BRI_DEC  &kp C_PREV  &kp C_PP      &kp C_NEXT    &none
                        &trans   &trans   &trans          &trans        &trans         &trans
            >;

            label = "Config";
        }; 
    };
};
