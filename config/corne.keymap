#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_vimwq {
            timeout-ms = <20>;
            key-positions = <1 2>;
            bindings = <&vim_quit>;
        };

        save_all {
            timeout-ms = <20>;
            bindings = <&save_all>;
            key-positions = <25 26>;
        };
    };

    macros {
        vim_quit: vim_quit {
            label = "ZM_vim_quit";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp ESC &kp COLON &kp W &kp Q &kp ENTER>;
        };
        save_all: save_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp LALT &kp S>,
                <&macro_release>,
                <&kp LEFT_GUI &kp LALT &kp S>;

            label = "SAVE_ALL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_layer {
            bindings = <
&none  &kp Q             &kp W  &kp E             &kp R      &kp T             &kp Y           &kp U       &kp I      &kp O    &kp P            &none
&none  &kp A             &kp S  &kp D             &kp F      &kp G             &kp H           &kp J       &kp K      &kp L    &kp BSPC         &none
&none  &ht LEFT_SHIFT Z  &kp X  &kp C             &kp V      &kp B             &kp N           &kp M       &kp COMMA  &kp DOT  &ht RSHFT QMARK  &none
                                &ht LEFT_ALT ESC  &lt 3 TAB  &ht LGUI SPACE    &ht RGUI ENTER  &lt 2 BSPC  &kp RCTRL
            >;

            label = "Mac";
        };

        windows_layer {
            bindings = <
&none  &kp Q  &kp W  &kp E          &kp R      &kp T              &kp Y            &kp U       &kp I      &kp O    &kp P      &none
&none  &kp A  &kp S  &kp D          &kp F      &kp G              &kp H            &kp J       &kp K      &kp L    &kp BSPC   &none
&none  &kp Z  &kp X  &kp C          &kp V      &kp B              &kp N            &kp M       &kp COMMA  &kp DOT  &kp QMARK  &none
                     &ht LSHFT ESC  &lt 3 TAB  &ht LCTRL SPACE    &ht RCTRL ENTER  &lt 2 BSPC  &kp RCTRL
            >;

            label = "Windows";
        };

        right_layer {
            bindings = <
&none  &kp ESC       &kp N7        &kp N8       &kp N9  &none       &none     &kp RC(LEFT)  &kp UP    &kp RC(RIGHT)  &none    &none
&none  &kp DEL       &kp N4        &kp N5       &kp N6  &none       &kp HOME  &kp LEFT      &kp DOWN  &kp RIGHT      &kp END  &none
&none  &ht LSHFT N0  &ht LCTRL N1  &ht LALT N2  &kp N3  &none       &none     &none         &none     &none          &none    &none
                                   &kp ESC      &trans  &kp LGUI    &trans    &trans        &trans
            >;

            label = "NumNav";
        };

        left_layer {
            bindings = <
&none  &kp EXCL   &kp AT     &kp HASH   &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &none
&none  &kp GRAVE  &kp MINUS  &kp PLUS   &kp PIPE  &kp SQT      &kp COLON  &kp LT    &kp GT     &kp LBKT  &kp RBKT  &none
&none  &kp TILDE  &kp UNDER  &kp EQUAL  &none     &kp DQT      &kp SEMI   &kp FSLH  &kp BSLH   &kp LBRC  &kp RBRC  &none
                             &trans     &trans    &trans       &trans     &trans    &trans
            >;

            label = "Symbols";
        };

        tri_layer {
            bindings = <
&none  &kp F1  &kp F2   &kp F3   &kp F4   &bt BT_SEL 0    &bt BT_SEL 2  &out OUT_TOG   &tog 1      &tog 5        &none         &none
&none  &kp F5  &kp F6   &kp F7   &kp F8   &bt BT_SEL 1    &bt BT_SEL 3  &kp C_BRI_UP   &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &none
&none  &kp F9  &kp F10  &kp F11  &kp F12  &bt BT_CLR      &bt BT_SEL 4  &kp C_BRI_DEC  &kp C_PREV  &kp C_PP      &kp C_NEXT    &none
                        &trans   &trans   &trans          &trans        &trans         &trans
            >;

            label = "Config";
        };

        games {
            bindings = <
&trans  &kp ESC    &kp Q   &kp W      &kp E   &kp R        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LSHFT  &kp A   &kp S      &kp D   &kp F        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LCTRL  &kp N1  &kp N2     &kp N3  &kp G        &trans  &trans  &trans  &trans  &trans  &trans
                           &kp LSHFT  &trans  &kp SPACE    &trans  &trans  &trans
            >;

            label = "Games";
        };
    };
};
